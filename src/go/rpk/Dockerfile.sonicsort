# syntax=docker/dockerfile:1
#
# Patched redpandadata/redpanda for SonicSort (poslogica/sonicsort), which
# runs a single dev-container broker for its download pipeline.
#
# SonicSort's image scan found the public image's Critical/High CVEs all in
# rpk: the Go stdlib of the toolchain it was built with, plus the x/net,
# x/text and grpc modules (bumped in this branch's go.mod). Redpanda itself
# (C++/Seastar) is unchanged -- this rebuilds only rpk, from this tag's
# src/go/rpk, on a current Go toolchain, and drops it into the official
# image of the same version.
#
# Flattened (final stage is FROM scratch + COPY of the whole filesystem):
# replacing rpk in a new layer would leave the old binary in the base
# image's lower layer, and scanners still report it from there. That means
# the image metadata below (ENV/USER/ENTRYPOINT/CMD/EXPOSE/VOLUME) is
# re-declared by hand -- keep it in step with `docker inspect` of
# REDPANDA_IMAGE when bumping it.
#
#   docker build -f Dockerfile.sonicsort -t sonicsort-redpanda:local .   (from src/go/rpk)

# Keep the redpandadata/redpanda FROM below in step with this branch's tag.
# It is written out, not an ARG: basewarden builds this with --pull off (it
# needs the local DEBIAN_BASE) and pulls the public images it finds in FROM
# lines itself, which skips ${ARG} references.
ARG RPK_VERSION=v26.2.2
# basewarden's Debian base, for its patched zlib1g (CVE-2026-85091; see
# poslogica/debuerreotype sonicsort/Dockerfile). basewarden passes it.
ARG DEBIAN_BASE=basewarden-debian:local

FROM ${DEBIAN_BASE} AS debian

FROM golang:1.27-alpine AS rpk
ARG RPK_VERSION
ARG COMMIT_ID=unknown
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
# Same -X stamps as build.sh.
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    ver_pkg=github.com/redpanda-data/redpanda/src/go/rpk/pkg/cli/version && \
    cont_pkg=github.com/redpanda-data/redpanda/src/go/rpk/pkg/cli/container/containerutil && \
    go build -trimpath -o /out/rpk -ldflags "-s -w \
      -X ${ver_pkg}.version=${RPK_VERSION} \
      -X ${ver_pkg}.rev=$(echo ${COMMIT_ID} | cut -c1-12) \
      -X ${cont_pkg}.tag=${RPK_VERSION} \
      -X ${ver_pkg}.buildTime=$(date -Iseconds) \
      -X ${ver_pkg}.hostOs=linux -X ${ver_pkg}.hostArch=amd64" \
      ./cmd/rpk

FROM redpandadata/redpanda:v26.2.2 AS patched
USER root
# Weekly cache-buster: SonicSort's build scripts pass the current ISO week,
# so the Debian upgrade below re-runs at least weekly.
ARG OS_PATCH_WEEK=unset
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
# The official image is trixie, like our base: take our patched zlib1g while
# it is newer than the image's own (the base leaves the directory empty once
# Debian's fix has replaced ours).
COPY --from=debian /var/lib/basewarden/apt/ /tmp/basewarden-apt/
RUN set -eu; \
    for deb in /tmp/basewarden-apt/zlib1g_*.deb; do \
      [ -e "$deb" ] || continue; \
      ours="$(dpkg-deb -f "$deb" Version)"; \
      have="$(dpkg-query -W -f '${Version}' zlib1g)"; \
      if dpkg --compare-versions "$ours" gt "$have"; then dpkg -i "$deb"; fi; \
    done; \
    rm -rf /tmp/basewarden-apt; \
    dpkg-query -W zlib1g
COPY --from=rpk /out/rpk /opt/redpanda/libexec/rpk
RUN /opt/redpanda/bin/rpk version

FROM scratch
COPY --from=patched / /

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    EDITOR=nano
USER redpanda
EXPOSE 8081 8082 9092 9644
VOLUME ["/var/lib/redpanda/data"]
ENTRYPOINT ["/entrypoint.sh"]
CMD ["redpanda", "start", "--overprovisioned"]
